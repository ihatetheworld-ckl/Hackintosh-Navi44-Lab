# Source normalization affects Git blobs/checkouts, not existing local files.
* text=auto eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.S text eol=lf
*.s text eol=lf
*.cl text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.plist text eol=lf
CMakeLists.txt text eol=lf
Makefile text eol=lf
# Historical patches and synthetic binary fixtures are byte-preserved.
*.patch -text
*.bin -text
*.png -text
*.jpg -text
*.jpeg -text
