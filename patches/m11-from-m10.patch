diff --git a/development/AMDRadeonRDNA4-Navi44/platform/shutdown.cpp b/development/AMDRadeonRDNA4-Navi44/platform/shutdown.cpp
new file mode 100644
index 0000000..c1d6282
--- /dev/null
+++ b/development/AMDRadeonRDNA4-Navi44/platform/shutdown.cpp
@@ -0,0 +1,87 @@
+#include "shutdown.hpp"
+namespace NaviPlatform {
+using namespace NaviCore;
+namespace {Result denied(){return failure("shutdown_context_or_reentry",Error::Protocol);}}
+Result GenerationClock::issue(uint64_t&out){
+    if(out)return failure("generation_output_occupied",Error::Protocol);
+    if(!access_.execution.enter||!access_.execution.leave||!access_.isHeld||!access_.isHeld(access_.execution.context))return denied();
+    if(!next_||next_==UINT64_MAX)return failure("generation_exhausted",Error::Budget);
+    out=next_++;return success();
+}
+bool ShutdownBarrier::held()const{return access_.execution.enter&&access_.execution.leave&&access_.isHeld&&access_.isHeld(access_.execution.context);}
+bool ShutdownBarrier::begin(){if(!held()||operation_)return false;operation_=true;return true;}
+Result ShutdownBarrier::bind(SnapshotOwner&o){
+    if(!begin())return denied();
+    const auto e=o.execution();Result r=success();
+    if(state_!=ShutdownState::Created||count_==8||e.context!=access_.execution.context||
+       e.enter!=access_.execution.enter||e.leave!=access_.execution.leave)r=failure("shutdown_binding",Error::Protocol);
+    else{
+        for(size_t i=0;i<count_;++i)if(owners_[i]==&o){end();return failure("shutdown_duplicate_owner",Error::Protocol);}
+        owners_[count_++]=&o;
+    }
+    end();return r;
+}
+Result ShutdownBarrier::start(){
+    if(!begin())return denied();Result r=success();
+    if(state_!=ShutdownState::Created||!count_)r=failure("shutdown_start_state",Error::Protocol);
+    else for(size_t i=0;i<count_;++i){OwnerState s{};size_t leases=0;r=owners_[i]->inspect(s,leases);
+        if(!r.ok()||s!=OwnerState::Active){r=failure("shutdown_partial_initialization",Error::Protocol);break;}}
+    if(r.ok())state_=ShutdownState::Active;end();return r;
+}
+Result ShutdownBarrier::borrow(size_t i,SnapshotTicket&t){
+    if(!begin())return denied();
+    Result r=state_==ShutdownState::Active&&i<count_?owners_[i]->borrow(t):failure("shutdown_no_new_ticket",Error::Protocol);
+    end();return r;
+}
+Result ShutdownBarrier::read(size_t i,const SnapshotTicket&t,View&out){
+    out={};if(!begin())return denied();
+    Result r=state_==ShutdownState::Active&&i<count_?owners_[i]->read(t,out):failure("shutdown_read_closed",Error::Protocol);
+    end();return r;
+}
+Result ShutdownBarrier::giveBack(size_t i,SnapshotTicket&t){
+    if(!begin())return denied();
+    Result r=i<count_?owners_[i]->giveBack(t):failure("shutdown_wrong_owner",Error::Protocol);
+    end();return r;
+}
+Result ShutdownBarrier::drainHeld(){
+    bool pending=false;Result error=success();
+    // Examine all owners before choosing a result; one pending owner must not
+    // keep unrelated owners active. Never wait or block while holding the gate.
+    for(size_t i=count_;i>0;--i){
+        auto&o=*owners_[i-1];if(o.readyToFree())continue;
+        OwnerState state{};size_t leases=0;Result r=o.inspect(state,leases);
+        if(!r.ok()){error=r;continue;}
+        // close invalidates new access even if an outstanding borrower exists.
+        if(failures_>=MaxCleanupFailures&&state==OwnerState::Failed&&!leases){error=failure("shutdown_retry_budget",Error::Budget);continue;}
+        r=o.close();
+        if(!r.ok()){if(leases)pending=true;else error=r;}
+    }
+    // Re-check after cleanup, including after the final ticket's giveBack.
+    bool ready=true;for(size_t i=0;i<count_;++i)ready=owners_[i]->readyToFree()&&ready;
+    if(ready){state_=ShutdownState::Released;return success();}
+    if(!error.ok()){if(failures_<MaxCleanupFailures)++failures_;state_=ShutdownState::Failed;return error;}
+    state_=ShutdownState::Draining;
+    return failure(pending?"shutdown_borrowers_pending":"shutdown_not_drained",Error::Protocol);
+}
+Result ShutdownBarrier::stop(){
+    if(!begin())return denied();if(state_==ShutdownState::Released){end();return success();}
+    // Transition first, before any foreign complete/release callback can reenter.
+    if(state_==ShutdownState::Created||state_==ShutdownState::Active)state_=ShutdownState::Stopping;
+    Result r=drainHeld();end();return r;
+}
+Result ShutdownBarrier::poll(){
+    if(!begin())return denied();
+    if(state_==ShutdownState::Created||state_==ShutdownState::Active){end();return failure("shutdown_poll_state",Error::Protocol);}
+    Result r=state_==ShutdownState::Released?success():drainHeld();end();return r;
+}
+bool ShutdownBarrier::readyToFree()const{
+    if(!held()||operation_||state_!=ShutdownState::Released)return false;
+    for(size_t i=0;i<count_;++i)if(!owners_[i]->readyToFree())return false;
+    return true;
+}
+Result ShutdownBarrier::inspect(ShutdownState&s,size_t&borrowers,unsigned&failures)const{
+    s=ShutdownState::Failed;borrowers=0;failures=0;if(!held()||operation_)return denied();
+    for(size_t i=0;i<count_;++i){OwnerState os{};size_t n=0;Result r=owners_[i]->inspect(os,n);if(!r.ok())return r;borrowers+=n;}
+    s=state_;failures=failures_;return success();
+}
+}
diff --git a/development/AMDRadeonRDNA4-Navi44/platform/shutdown.hpp b/development/AMDRadeonRDNA4-Navi44/platform/shutdown.hpp
new file mode 100644
index 0000000..ac2420e
--- /dev/null
+++ b/development/AMDRadeonRDNA4-Navi44/platform/shutdown.hpp
@@ -0,0 +1,34 @@
+// Caller-serialized shutdown over existing SnapshotOwner; BSD-3-Clause.
+#ifndef Navi44Shutdown_hpp
+#define Navi44Shutdown_hpp
+#include "lifecycle.hpp"
+namespace NaviPlatform {
+// One long-lived issuer per ownership domain, under its exact gate. Never reset
+// or recreate it while stale tickets can exist. Address identity alone is not ABA-safe.
+class GenerationClock {
+    AccessOps access_;uint64_t next_;
+public:
+    explicit GenerationClock(AccessOps access,uint64_t first=1):access_(access),next_(first){}
+    GenerationClock(const GenerationClock&)=delete;GenerationClock&operator=(const GenerationClock&)=delete;
+    NaviCore::Result issue(uint64_t&);
+};
+enum class ShutdownState:uint8_t { Created,Active,Stopping,Draining,Failed,Released };
+class ShutdownBarrier {
+    AccessOps access_;SnapshotOwner*owners_[8]{};size_t count_{0};
+    ShutdownState state_{ShutdownState::Created};bool operation_{false};unsigned failures_{0};
+    bool held()const;bool begin();void end(){operation_=false;}
+    NaviCore::Result drainHeld();
+public:
+    static constexpr unsigned MaxCleanupFailures=4;
+    explicit ShutdownBarrier(AccessOps access):access_(access){}
+    ShutdownBarrier(const ShutdownBarrier&)=delete;ShutdownBarrier&operator=(const ShutdownBarrier&)=delete;
+    // Owner storage and gate must outlive this barrier and every outstanding ticket.
+    NaviCore::Result bind(SnapshotOwner&);NaviCore::Result start();
+    NaviCore::Result borrow(size_t,SnapshotTicket&);NaviCore::Result read(size_t,const SnapshotTicket&,NaviCore::View&);
+    NaviCore::Result giveBack(size_t,SnapshotTicket&);
+    NaviCore::Result stop();NaviCore::Result poll();
+    bool readyToFree()const;
+    NaviCore::Result inspect(ShutdownState&,size_t&,unsigned&)const;
+};
+}
+#endif
diff --git a/docs/m11/concurrency-and-ownership.md b/docs/m11/concurrency-and-ownership.md
new file mode 100644
index 0000000..b315abe
--- /dev/null
+++ b/docs/m11/concurrency-and-ownership.md
@@ -0,0 +1,20 @@
+# M11 并发证据边界
+
+同步仍通过现有AccessOps/ExecutionOps注入。Host ThreadGate使用std::mutex/TLS，
+禁止同线程嵌套gate和模拟中断上下文。SnapshotOwner/ShutdownBarrier回调有重入拒绝。
+内核锁/工作循环没有在用户态执行，bool状态也不是内核锁。
+
+锁顺序：先生命周期gate，操作资源状态；离开gate之后才持Host通知mutex或等待。
+不在gate下等待drain、join或condition_variable。模型ReferenceOps callback不得阻塞等待
+另一个需要gate的线程；Native分配还需合法可睡眠线程上下文，这部分尚UNVERIFIED。
+
+M11并发为两worker各160次，总320次。通知协议保证两张ticket在stop时仍未归还，
+然后在关闭后归还；其余318次新获取被拒绝。等待各2秒，外层用户程序30秒。
+最初版本在快机器上可能320次全拒绝；已经补同步点，最终普通/ASan/TSan都实际
+acquired=2、denied=318、errors=0，不用全拒绝冒充交叉生命周期覆盖。
+M10旧240次worker及shutdown borrower继续作为回归，次数不累积到M11新增行为。
+
+59项M11行为、400组有限初始化故障和上述线程协议在普通/ASan+UBSan/TSan实际通过。
+没有无限fuzz。TSan的证明范围是已插桩的Host ownership/gate路径；旧不可变parser在
+TSan生命周期链接中没有插桩，真实IOKit线程、OSObject、设备与内核内存模型均UNVERIFIED。
+ASan leak detection关闭，leak NOT VERIFIED；源码没有假定这些结果授权硬件能力提升。
diff --git a/docs/m11/ioservice-lifecycle.md b/docs/m11/ioservice-lifecycle.md
new file mode 100644
index 0000000..282dea6
--- /dev/null
+++ b/docs/m11/ioservice-lifecycle.md
@@ -0,0 +1,26 @@
+# M11 IOService接口契约
+
+tests/unit/m11_native_compile.cpp采用真实IOService继承/override原型，类抽象且没有
+OSDefineMetaClass注册。start/open始终拒绝；不连接provider、不访问Registry/PCI。
+init/stop/willTerminate/didTerminate只在编译探针中检查super接口，均不运行。
+free受protected限制，只表示最后引用释放时的回调，不允许外部probe任意调用。
+
+Apple [基类生命周期](https://developer.apple.com/library/archive/documentation/DeviceDrivers/Conceptual/IOKitFundamentals/BaseClasses/BaseClasses.html)
+规定初始化与清理的super调用顺序；
+[移除流程](https://developer.apple.com/library/archive/documentation/DeviceDrivers/Conceptual/IOKitFundamentals/DeviceRemoval/DeviceRemoval.html)
+区分失效、等待请求、stop/detach和最终释放，didTerminate可延迟终止。
+这些是Kernel IOKit文档，不混用DriverKit Start/Stop的不同API。
+
+原probe在任意外部引用上直接调用free，Apple分析器实际报osx.cocoa.RetainCount。
+已移除外部free调用，并限制可见性，真正重新分析为零warning；未禁用checker。
+生产实现必须由最后release触发free，不能用readyToFree许可去直接free一个仍有OSObject
+引用的对象。readyToFree只保护内部资源/存储，OSObject引用是另一层约束。
+
+NativeOwnerStorage将NativeSnapshot、ShutdownBarrier和NodePool放在caller长期拥有的
+存储中。初始化失败执行关闭；Snapshot工厂引用仍按M10真实API配对，OSData/Buffer不
+prepare/complete、映射或DMA。scratch新获取要求ACTIVE且持gate，归还允许关闭阶段；
+NodePool非idle时readyToFree拒绝物理释放。没有把Host普通内存称为真实内核对象。
+
+真实服务owner强引用、workloop/command gate、普通线程/中断区分及终止回调调度尚未
+集成/执行。没有可运行服务类或设备匹配。IOService init/start/stop/free/open/close/
+terminate/willTerminate/didTerminate运行全部NOT RUN。
