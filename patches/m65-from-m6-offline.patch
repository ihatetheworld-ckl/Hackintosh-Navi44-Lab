+bool Offline::elf(const uint8_t *d, size_t n, Asic::Target target, const char **why) {
+    try { validateElf(d, n, target); if (why) *why = nullptr; return true; }
+    catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+bool Offline::elfKernel(const uint8_t *d, size_t n, Asic::Target target, const char *name, const char **why) {
+    try {
+        if (!name || !*name) throw Invalid {"elf_kernel_metadata_missing"};
+        validateElf(d, n, target, name); if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+
+bool Offline::firmware(const uint8_t *d, size_t n, uint16_t major, uint16_t minor,
+                       const char *component, const char **why) {
+    try {
+        if (!d) throw Invalid {"out_of_bounds"};
+        range(n, 0, 32);
+        if (u16(d + 8) != 1 || u16(d + 10) != 0) throw Invalid {"firmware_header_version"};
+        const uint32_t size = u32(d), header = u32(d + 4), count = u32(d + 20), off = u32(d + 24);
+        if (size != n || header < 32 || header > size || off < header || !count) throw Invalid {"firmware_size"};
+        range(size, off, count);
+        if (u16(d + 12) != major || u16(d + 14) != minor) throw Invalid {"firmware_ip_mismatch"};
+        bool supported = false;
+        for (const char *s : {"pfp","me","mec","rlc","imu","mes","mes1","sos","ta","smu","sdma","dmub"})
+            if (component && !std::strcmp(s, component)) supported = true;
+        if (!supported) throw Invalid {"firmware_component_unsupported"};
+        // Common header does not encode component ID or revision. Sidecar isn't proof.
+        if (u32(d + 28)) throw Invalid {"firmware_crc_unverified"};
+        if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+
+bool Offline::deviceInfo(const uint8_t *d, size_t n, Asic::Profile &out, const char **why) {
+    out = Asic::identify(0, 0);
+    try {
+        if (!d || n != 32) throw Invalid {"abi_size"};
+        if (std::memcmp(d, "N44I", 4) || u16(d + 4) != 1 || u16(d + 6) != 32 ||
+            d[13] > 1 || u64(d + 16) || u64(d + 24)) throw Invalid {"abi_header_or_capabilities"};
+        if (u16(d + 8) != 0x1002) throw Invalid {"unknown_vendor"};
+        auto p = Asic::identify(u16(d + 8), u16(d + 10), d[12], d[13] != 0);
+        if (p.family == Asic::Family::Unknown) throw Invalid {"unknown_device"};
+        if (u16(d + 14) != uint16_t(p.target) || (!d[13] && d[12])) throw Invalid {"abi_target_or_revision"};
+        out = p; if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+
+bool Offline::firmwareRequirements(const Asic::Profile &p, const IpDiscovery &discovery,
+                                  FirmwareRequirement (&out)[16], size_t &count, const char **why) {
+    count = 0;
+    auto fail = [&](const char *w) { count = 0; if (why) *why = w; return false; };
+    const auto expected = Asic::identify(p.vendor, p.device, p.revision, p.revisionKnown);
+    if (expected.family == Asic::Family::Unknown || p.family != expected.family || p.target != expected.target || p.capabilities)
+        return fail("profile_tampered");
+    IpDiscovery::IpEntry64 gc;
+    if (!discovery.findIp64(11,0,gc) || gc.major != expected.expectedGc.major ||
+        gc.minor != expected.expectedGc.minor || gc.revision != expected.expectedGc.revision) return fail("gc_profile_mismatch");
+    uint32_t se = 0, rb = 0;
+    if (!discovery.gcInfo(se,rb)) return fail("topology_unknown");
+    struct Part { uint16_t hw; const char *block; const char *component; };
+    const Part parts[] = {{11,"gc","pfp"},{11,"gc","me"},{11,"gc","mec"},{11,"gc","rlc"},
+        {11,"gc","imu"},{11,"gc","mes"},{11,"gc","mes1"},{255,"psp","sos"},{255,"psp","ta"},
+        {1,"smu","smu"},{42,"sdma","sdma"},{271,"dcn","dmub"}};
+    for (const auto &part : parts) {
+        IpDiscovery::IpEntry64 ip;
+        if (!discovery.findIp64(part.hw,0,ip)) {
+            if (part.hw == 255) return fail("required_ip_missing:psp");
+            if (part.hw == 1) return fail("required_ip_missing:smu");
+            if (part.hw == 42) return fail("required_ip_missing:sdma");
+            if (part.hw == 271) return fail("required_ip_missing:dcn");
+            return fail("required_ip_missing:gc");
+        }
+        out[count++] = {part.block,part.component,{ip.major,ip.minor,ip.revision,true}};
+    }
+    if (why) *why = nullptr;
+    return true; // Advisory structural requirements; no firmware signature/load.
