+            check("read_after_close_clears",!owner.read(ticket,view).ok()&&!view.data&&!view.size);
+            check("return_completes_shutdown",owner.giveBack(ticket).ok()&&!ticket.serial&&resource.releases==1&&owner.readyToFree());
+            auto duplicate=copy;
