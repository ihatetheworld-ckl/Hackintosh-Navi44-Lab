diff --git a/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.cpp b/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.cpp
new file mode 100644
index 0000000..4d2c394
--- /dev/null
+++ b/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.cpp
@@ -0,0 +1,54 @@
+// Object code only: none of these kernel calls is executed by Host tests.
+#include "darwin_snapshot.hpp"
+#include <libkern/c++/OSData.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+namespace NaviDarwin {
+using namespace NaviCore;
+// Public SDK defaults to raw OSPtr, not experimental OSSharedPtr factories.
+static_assert(__is_same(OSPtr<OSData>,OSData*),"use the audited public raw factory ABI");
+static_assert(sizeof(size_t)>=sizeof(IOByteCount),"descriptor length must not narrow");
+bool NativeSnapshot::retain(void*ctx){
+    auto&s=*static_cast<NativeSnapshot*>(ctx);if(!s.object_)return false;
+    s.object_->retain();return true;
+}
+void NativeSnapshot::release(void*ctx){
+    auto&s=*static_cast<NativeSnapshot*>(ctx);OSObject*p=s.object_;s.object_=nullptr;
+    if(p)p->release();
+}
+Result NativeSnapshot::view(void*ctx,View&out){
+    auto&s=*static_cast<NativeSnapshot*>(ctx);out={};
+    if(!s.object_)return failure("native_snapshot_missing",Error::Missing);
+    if(s.kind_==CpuSnapshotStorage::DataCopy){
+        const auto*data=static_cast<const OSData*>(s.object_);
+        out={static_cast<const uint8_t*>(data->getBytesNoCopy()),data->getLength()};
+    }else{
+        auto*buffer=static_cast<IOBufferMemoryDescriptor*>(s.object_);
+        out={static_cast<const uint8_t*>(buffer->getBytesNoCopy()),static_cast<size_t>(buffer->getLength())};
+    }
+    return success();
+}
+Result NativeSnapshot::createCopy(View input,CpuSnapshotStorage kind){
+    NaviPlatform::OwnerState state{};size_t leases=0;
+    Result r=owner_.inspect(state,leases);if(!r.ok())return r;
+    if(state!=NaviPlatform::OwnerState::Created||object_)return failure("native_snapshot_state",Error::Protocol);
+    const uintptr_t address=reinterpret_cast<uintptr_t>(input.data);
+    if(!input.data||!input.size||input.size>NaviPlatform::SnapshotOwner::MaxBytes||input.size-1>UINTPTR_MAX-address)
+        return failure("native_snapshot_bounds",Error::Bounds);
+    kind_=kind;NaviPlatform::ReferenceOps ref{this,retain,release,view,nullptr,nullptr};
+    if(kind==CpuSnapshotStorage::DataCopy){
+        static_assert(NaviPlatform::SnapshotOwner::MaxBytes<=UINT32_MAX,"OSData length narrowing");
+        auto data=OSData::withBytes(input.data,static_cast<unsigned int>(input.size));
+        if(!data)return failure("native_data_allocation",Error::Budget);
+        object_=data;r=owner_.activate(ref);
+        // The public raw factory returns reference count 1. Drop that initial
+        // reference after activate retained its own, including failure cleanup.
+        data->release();if(!r.ok())object_=nullptr;return r;
+    }
+    if(kind==CpuSnapshotStorage::BufferCopy){
+        auto buffer=IOBufferMemoryDescriptor::withBytes(input.data,static_cast<vm_size_t>(input.size),kIODirectionNone);
+        if(!buffer)return failure("native_buffer_allocation",Error::Budget);
+        object_=buffer;r=owner_.activate(ref);buffer->release();if(!r.ok())object_=nullptr;return r;
+    }
+    return failure("native_snapshot_storage",Error::Unsupported);
+}
+}
diff --git a/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.hpp b/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.hpp
new file mode 100644
index 0000000..2d21b6f
--- /dev/null
+++ b/development/AMDRadeonRDNA4-Navi44/platform/darwin_snapshot.hpp
@@ -0,0 +1,25 @@
+// Genuine Apple API adapter, compile/partial-link only. BSD-3-Clause.
+#ifndef Navi44DarwinSnapshot_hpp
+#define Navi44DarwinSnapshot_hpp
+#if !defined(__APPLE__) || !defined(KERNEL)
+#error Genuine separately authorized kernel object build required
+#endif
+#include "lifecycle.hpp"
+#include <libkern/c++/OSObject.h>
+namespace NaviDarwin {
+enum class CpuSnapshotStorage:uint8_t { DataCopy,BufferCopy };
+// Caller owns long-lived wrapper/gate storage. No IOService/UserClient/GPU entry.
+// Close/return all leases under gate and require readyToFree before freeing it.
+class NativeSnapshot {
+    NaviPlatform::SnapshotOwner owner_;
+    OSObject*object_{nullptr};CpuSnapshotStorage kind_{CpuSnapshotStorage::DataCopy};
+    static bool retain(void*);static void release(void*);
+    static NaviCore::Result view(void*,NaviCore::View&);
+public:
+    NativeSnapshot(NaviPlatform::AccessOps access,uint64_t generation):owner_(access,generation){}
+    NativeSnapshot(const NativeSnapshot&)=delete;NativeSnapshot&operator=(const NativeSnapshot&)=delete;
+    NaviCore::Result createCopy(NaviCore::View,CpuSnapshotStorage);
+    NaviPlatform::SnapshotOwner&owner(){return owner_;}
+};
+}
+#endif
diff --git a/development/AMDRadeonRDNA4-Navi44/platform/lifecycle.cpp b/development/AMDRadeonRDNA4-Navi44/platform/lifecycle.cpp
new file mode 100644
index 0000000..76e5127
--- /dev/null
+++ b/development/AMDRadeonRDNA4-Navi44/platform/lifecycle.cpp
@@ -0,0 +1,106 @@
+#include "lifecycle.hpp"
+namespace NaviPlatform {
+using namespace NaviCore;
+namespace { Result context(){return failure("lifetime_context_or_reentry",Error::Protocol);} }
+bool SnapshotOwner::held()const{
+    return access_.execution.enter&&access_.execution.leave&&access_.isHeld&&
+        access_.isHeld(access_.execution.context);
+}
+SnapshotOwner::Call::Call(SnapshotOwner&o):owner(o),entered(o.held()&&!o.operation_){
+    if(entered)o.operation_=true;
+}
+SnapshotOwner::Call::~Call(){if(entered)owner.operation_=false;}
+bool SnapshotOwner::valid(const SnapshotTicket&t)const{
+    return t.owner==generation_&&t.serial&&t.slot<MaxLeases&&slots_[t.slot]==t.serial;
+}
+Result SnapshotOwner::finish(){
+    if(leases_)return failure("snapshot_shutdown_pending",Error::Protocol);
+    if(prepared_){
+        Result r=reference_.complete(reference_.context);
+        if(!r.ok()){state_=OwnerState::Failed;return r;}
+        prepared_=false;
+    }
+    input_={};state_=OwnerState::Released;
+    if(retained_){retained_=false;reference_.release(reference_.context);}
+    reference_={};return success();
+}
+Result SnapshotOwner::fail(Result error){
+    input_={};Result cleanup=finish();state_=OwnerState::Failed;
+    return cleanup.ok()?error:cleanup;
+}
+Result SnapshotOwner::activate(ReferenceOps ref,bool needsPreparation){
+    Call call{*this};if(!call.entered)return context();
+    if(state_!=OwnerState::Created)return failure("snapshot_activation_state",Error::Protocol);
+    if(!generation_||!ref.retain||!ref.release||!ref.view||
+       (needsPreparation&&(!ref.prepare||!ref.complete))){
+        state_=OwnerState::Failed;return failure("snapshot_reference_contract",Error::Protocol);
+    }
+    reference_=ref;
+    if(!reference_.retain(reference_.context)){state_=OwnerState::Failed;reference_={};return failure("snapshot_retain_failed",Error::Budget);}
+    retained_=true;
+    Result r=reference_.view(reference_.context,input_);if(!r.ok())return fail(r);
+    const uintptr_t address=reinterpret_cast<uintptr_t>(input_.data);
+    if(!input_.data||!input_.size||input_.size>MaxBytes||input_.size-1>UINTPTR_MAX-address)
+        return fail(failure("snapshot_view_bounds",Error::Bounds));
+    if(needsPreparation){r=reference_.prepare(reference_.context);if(!r.ok())return fail(r);prepared_=true;}
+    state_=OwnerState::Active;return success();
+}
+Result SnapshotOwner::borrowHeld(SnapshotTicket&out){
+    out={};if(state_!=OwnerState::Active)return failure("snapshot_not_active",Error::Protocol);
+    if(leases_==MaxLeases||next_==UINT64_MAX)return failure("snapshot_lease_budget",Error::Budget);
+    size_t i=0;while(i<MaxLeases&&slots_[i])++i;
+    if(i==MaxLeases)return failure("snapshot_slot_state",Error::Protocol);
+    slots_[i]=next_++;++leases_;out={generation_,slots_[i],i};return success();
+}
+Result SnapshotOwner::borrow(SnapshotTicket&out){
+    // Do not overwrite an existing obligation to return a live ticket.
+    if(out.owner||out.serial)return failure("snapshot_ticket_output_occupied",Error::Protocol);
+    out={};Call call{*this};return call.entered?borrowHeld(out):context();
+}
+Result SnapshotOwner::readHeld(const SnapshotTicket&t,View&out)const{
+    out={};if(!valid(t))return failure("snapshot_ticket_invalid",Error::Protocol);
+    if(state_!=OwnerState::Active)return failure("snapshot_revoked_or_closing",Error::Protocol);
+    out=input_;return success();
+}
+Result SnapshotOwner::read(const SnapshotTicket&t,View&out){
+    out={};Call call{*this};return call.entered?readHeld(t,out):context();
+}
+Result SnapshotOwner::returnHeld(SnapshotTicket&t){
+    if(!valid(t))return failure("snapshot_ticket_invalid",Error::Protocol);
+    slots_[t.slot]=0;--leases_;t={};
+    if(state_!=OwnerState::Active&&leases_==0)return finish();
+    return success();
+}
+Result SnapshotOwner::giveBack(SnapshotTicket&t){
+    Call call{*this};return call.entered?returnHeld(t):context();
+}
+Result SnapshotOwner::stop(OwnerState state){
+    Call call{*this};if(!call.entered)return context();
+    if(state_==OwnerState::Released)return success();
+    if(state_==OwnerState::Active||state_==OwnerState::Created)state_=state;
+    // Close may follow revoke/failed completion; retry cleanup without reopening.
+    input_={};return finish();
+}
+Result SnapshotOwner::close(){return stop(OwnerState::Closing);}
+Result SnapshotOwner::revoke(){return stop(OwnerState::Revoked);}
+bool SnapshotOwner::readyToFree()const{
+    return held()&&!operation_&&state_==OwnerState::Released&&!leases_&&!retained_&&!prepared_;
+}
+Result SnapshotOwner::inspect(OwnerState&state,size_t&count)const{
+    state=OwnerState::Failed;count=0;if(!held()||operation_)return context();
+    state=state_;count=leases_;return success();
+}
+Result SnapshotOwner::legacyBorrow(void*ctx,SnapshotKind kind,View&out){
+    auto&o=*static_cast<SnapshotOwner*>(ctx);out={};Call call{o};if(!call.entered)return context();
+    if(kind!=o.kind_||o.legacy_)return failure("snapshot_legacy_borrow",Error::Protocol);
+    Result r=o.borrowHeld(o.legacyTicket_);if(!r.ok())return r;
+    r=o.readHeld(o.legacyTicket_,out);
+    if(!r.ok()){o.returnHeld(o.legacyTicket_);return r;}
+    o.legacy_=true;o.legacyView_=out;return success();
+}
+void SnapshotOwner::legacyRelease(void*ctx,View input){
+    auto&o=*static_cast<SnapshotOwner*>(ctx);Call call{o};if(!call.entered)return;
+    if(!o.legacy_||input.data!=o.legacyView_.data||input.size!=o.legacyView_.size)return;
+    o.legacy_=false;o.legacyView_={};o.returnHeld(o.legacyTicket_);
+}
+}
