+namespace {
+struct Invalid { const char *why; };
+void range(uint64_t n, uint64_t off, uint64_t count) {
+    if (off > n || count > n - off) throw Invalid {"out_of_bounds"};
+}
+uint16_t u16(const uint8_t *p) { return uint16_t(p[0]) | uint16_t(p[1]) << 8; }
+uint32_t u32(const uint8_t *p) { return uint32_t(u16(p)) | uint32_t(u16(p + 2)) << 16; }
+uint64_t u64(const uint8_t *p) { return uint64_t(u32(p)) | uint64_t(u32(p + 4)) << 32; }
+struct Value {
+    enum Kind { Number, String, Map, Array } kind;
+    uint64_t number {0}; std::string string;
+    std::map<std::string, Value> map;
+    std::vector<Value> array;
+    explicit Value(Kind k) : kind(k) {}
+};
+bool utf8(const std::string &s) {
+    for (size_t i = 0; i < s.size();) {
+        uint32_t c = static_cast<uint8_t>(s[i++]);
+        if (c < 0x80) continue;
+        unsigned following; uint32_t minimum;
+        if (c >= 0xc2 && c <= 0xdf) { following = 1; minimum = 0x80; c &= 31; }
+        else if (c >= 0xe0 && c <= 0xef) { following = 2; minimum = 0x800; c &= 15; }
+        else if (c >= 0xf0 && c <= 0xf4) { following = 3; minimum = 0x10000; c &= 7; }
+        else return false;
+        if (following > s.size() - i) return false;
+        while (following--) { uint8_t b = uint8_t(s[i++]); if ((b & 0xc0) != 0x80) return false; c = (c << 6) | (b & 63); }
+        if (c < minimum || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff)) return false;
+    }
+    return true;
+}
+class Metadata {
+    const uint8_t *d; size_t n, pos {0};
+    uint64_t big(unsigned width) {
+        range(n, pos, width); uint64_t x = 0;
+        while (width--) x = (x << 8) | d[pos++];
+        return x;
+    }
+    Value parse(unsigned depth) {
+        if (depth > 16) throw Invalid {"metadata_depth"};
+        range(n, pos, 1); const uint8_t tag = d[pos++];
+        if (tag < 0x80) { Value v(Value::Number); v.number = tag; return v; }
+        if ((tag >= 0xa0 && tag <= 0xbf) || tag == 0xd9 || tag == 0xda || tag == 0xdb) {
+            const uint64_t count = tag <= 0xbf ? tag & 31 : big(tag == 0xd9 ? 1 : tag == 0xda ? 2 : 4);
+            range(n, pos, count); Value v(Value::String);
+            v.string.assign(reinterpret_cast<const char *>(d + pos), size_t(count)); pos += size_t(count);
+            if (!utf8(v.string)) throw Invalid {"metadata_utf8"};
+            return v;
+        }
+        const bool map = (tag >= 0x80 && tag <= 0x8f) || tag == 0xde || tag == 0xdf;
+        const bool array = (tag >= 0x90 && tag <= 0x9f) || tag == 0xdc || tag == 0xdd;
