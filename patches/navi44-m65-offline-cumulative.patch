+bool validateElf(const uint8_t *d, size_t n, Asic::Target target, const char *kernelName = nullptr) {
+    if (target != Asic::Target::Gfx1200 && target != Asic::Target::Gfx1201) throw Invalid {"unknown_target"};
+    if (!d) throw Invalid {"out_of_bounds"};
+    range(n, 0, 64);
+    const uint8_t ident[] = {0x7f, 'E', 'L', 'F', 2, 1, 1};
+    if (std::memcmp(d, ident, sizeof(ident))) throw Invalid {"elf_ident"};
+    if (u16(d + 16) != 3 || u16(d + 18) != 224 || u32(d + 20) != 1)
+        throw Invalid {"elf_type_machine_version"};
+    if ((u32(d + 48) & 255) != uint32_t(target)) throw Invalid {"elf_target_mismatch"};
+    const uint16_t phSize = u16(d + 54), phCount = u16(d + 56), shSize = u16(d + 58), shCount = u16(d + 60);
+    const uint64_t phOff = u64(d + 32), shOff = u64(d + 40);
+    if (u16(d + 52) != 64 || phSize != 56 || shSize != 64 || !phCount || !shCount)
+        throw Invalid {"elf_tables_missing"};
+    range(n, phOff, uint64_t(phSize) * phCount); range(n, shOff, uint64_t(shSize) * shCount);
