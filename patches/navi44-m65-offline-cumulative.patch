+                            const auto it = k.map.find(pair.first);
+                            if (it != k.map.end() && (it->second.kind != Value::Number || it->second.number != pair.second))
+                                throw Invalid {"elf_descriptor_mismatch"};
+                        }
+                    }
+                    if (!found) throw Invalid {"elf_kernel_metadata_missing"};
+                }
+            }
+            p = next;
+        }
+    }
+    if (!loads || !metadata) throw Invalid {"elf_load_or_metadata_missing"};
+    return true;
+}
+}
