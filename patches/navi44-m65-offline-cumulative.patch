+    // Otherwise a corrupt later string table is diagnosed only after traversal.
+    for (unsigned i = 0; i < shCount; ++i) {
+        const uint8_t *s = d + shOff + uint64_t(i) * shSize;
+        if (u32(s + 4) != 8) range(n, u64(s + 24), u64(s + 32));
+    }
+    unsigned loads = 0; bool metadata = false;
+    for (unsigned i = 0; i < phCount; ++i) {
+        const uint8_t *p = d + phOff + uint64_t(i) * phSize;
+        if (u32(p) != 1) continue;
+        const uint64_t off = u64(p + 8), va = u64(p + 16), file = u64(p + 32), mem = u64(p + 40);
+        range(n, off, file); range(16u << 20, va, mem);
