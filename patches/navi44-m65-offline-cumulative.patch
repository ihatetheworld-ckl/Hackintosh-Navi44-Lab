+bool Offline::elf(const uint8_t *d, size_t n, Asic::Target target, const char **why) {
+    try { validateElf(d, n, target); if (why) *why = nullptr; return true; }
+    catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+bool Offline::elfKernel(const uint8_t *d, size_t n, Asic::Target target, const char *name, const char **why) {
+    try {
+        if (!name || !*name) throw Invalid {"elf_kernel_metadata_missing"};
+        validateElf(d, n, target, name); if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+
+bool Offline::firmware(const uint8_t *d, size_t n, uint16_t major, uint16_t minor,
+                       const char *component, const char **why) {
+    try {
+        if (!d) throw Invalid {"out_of_bounds"};
+        range(n, 0, 32);
+        if (u16(d + 8) != 1 || u16(d + 10) != 0) throw Invalid {"firmware_header_version"};
+        const uint32_t size = u32(d), header = u32(d + 4), count = u32(d + 20), off = u32(d + 24);
+        if (size != n || header < 32 || header > size || off < header || !count) throw Invalid {"firmware_size"};
+        range(size, off, count);
+        if (u16(d + 12) != major || u16(d + 14) != minor) throw Invalid {"firmware_ip_mismatch"};
+        bool supported = false;
+        for (const char *s : {"pfp","me","mec","rlc","imu","mes","mes1","sos","ta","smu","sdma","dmub"})
+            if (component && !std::strcmp(s, component)) supported = true;
+        if (!supported) throw Invalid {"firmware_component_unsupported"};
+        // Common header does not encode component ID or revision. Sidecar isn't proof.
+        if (u32(d + 28)) throw Invalid {"firmware_crc_unverified"};
+        if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
+
+bool Offline::deviceInfo(const uint8_t *d, size_t n, Asic::Profile &out, const char **why) {
+    out = Asic::identify(0, 0);
+    try {
+        if (!d || n != 32) throw Invalid {"abi_size"};
+        if (std::memcmp(d, "N44I", 4) || u16(d + 4) != 1 || u16(d + 6) != 32 ||
+            d[13] > 1 || u64(d + 16) || u64(d + 24)) throw Invalid {"abi_header_or_capabilities"};
+        if (u16(d + 8) != 0x1002) throw Invalid {"unknown_vendor"};
+        auto p = Asic::identify(u16(d + 8), u16(d + 10), d[12], d[13] != 0);
