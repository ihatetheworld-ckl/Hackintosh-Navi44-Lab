+        if (u16(d + 14) != uint16_t(p.target) || (!d[13] && d[12])) throw Invalid {"abi_target_or_revision"};
+        out = p; if (why) *why = nullptr; return true;
+    } catch (const Invalid &e) { if (why) *why = e.why; return false; }
+}
