+        ++loads;
+    }
+    for (unsigned i = 0; i < shCount; ++i) {
+        const uint8_t *s = d + shOff + uint64_t(i) * shSize;
+        const uint32_t type = u32(s + 4); const uint64_t off = u64(s + 24), size = u64(s + 32);
+        // Validate every file-backed section, not only SHT_NOTE.
+        if (type != 8) range(n, off, size);
+        if (type != 7) continue;
