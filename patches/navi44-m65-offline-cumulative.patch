+                    for (const auto &k : decoded.map.at("amdhsa.kernels").array) {
+                        if (k.map.at(".name").string != kernelName) continue;
+                        if (found) throw Invalid {"elf_kernel_metadata_duplicate"};
+                        found = true;
+                        if (k.map.at(".symbol").string != std::string(kernelName) + ".kd")
