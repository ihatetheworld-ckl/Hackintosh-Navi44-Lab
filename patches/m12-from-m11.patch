+    }
+};
+int main(){unsigned pass=0,fail=0;
+    auto check=[&](const char*n,bool b){std::cout<<(b?"PASS ":"FAIL ")<<n<<'\n';b?++pass:++fail;};
+    {
+        ThreadGate gate;ReferenceMock r;for(size_t i=0;i<r.bytes.size();++i)r.bytes[i]=static_cast<uint8_t>(i);
